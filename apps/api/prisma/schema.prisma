generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  // Technician is a User with this role — no separate Technician entity.
  TECHNICIAN
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  DESKTOP
  WATCH
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  REPAIRING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum StockMovementReason {
  PURCHASE_RECEIVED
  TICKET_USAGE
  TICKET_RETURN
  SALE
  SALE_VOID
  ADJUSTMENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               UserRole @default(STAFF)
  isActive           Boolean  @default(true)
  phone              String?
  // Used for labor cost and revenue-per-hour metrics.
  hourlyRate         Decimal? @db.Decimal(10, 2)
  // Monthly sales goal shown on the staff performance report.
  monthlySalesTarget Decimal? @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedTickets   RepairTicket[]        @relation("AssignedTo")
  createdTickets    RepairTicket[]        @relation("CreatedBy")
  statusChanges     TicketStatusHistory[]
  repairNotes       RepairNote[]
  ticketItems       TicketItem[]
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  invoices          Invoice[]             @relation("InvoiceCreatedBy")
  voidedInvoices    Invoice[]             @relation("InvoiceVoidedBy")
  timeEntries       TimeEntry[]           @relation("TimeEntryUser")
  editedTimeEntries TimeEntry[]           @relation("TimeEntryEditedBy")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices  Device[]
  tickets  RepairTicket[]
  invoices Invoice[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Device {
  id           String     @id @default(cuid())
  customerId   String
  type         DeviceType
  brand        String
  model        String
  serialNumber String?
  imei         String?
  // Stored AES-256-GCM encrypted. Encryption key from environment variable.
  passcode     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets  RepairTicket[]

  @@index([customerId])
  @@index([serialNumber])
  @@index([imei])
  @@map("devices")
}

model RepairTicket {
  id                   String       @id @default(cuid())
  ticketNumber         String       @unique
  customerId           String
  deviceId             String
  assignedToId         String?
  createdById          String
  status               TicketStatus @default(RECEIVED)
  priority             Priority     @default(NORMAL)
  reportedProblem      String
  diagnosis            String?
  estimatedCost        Decimal?     @db.Decimal(10, 2)
  finalCost            Decimal?     @db.Decimal(10, 2)
  receivedAt           DateTime     @default(now())
  expectedCompletionAt DateTime?
  completedAt          DateTime?
  // Set while a non-void invoice exists; locks items and routes payments to the invoice.
  invoicedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  statusHistory TicketStatusHistory[]
  repairNotes   RepairNote[]
  payments      Payment[]
  items         TicketItem[]
  invoices      Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([assignedToId])
  @@index([ticketNumber])
  @@index([priority])
  @@index([status, createdAt])
  @@map("repair_tickets")
}

// Append-only audit log — never updated, only inserted.
model TicketStatusHistory {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  notes       String?
  changedAt   DateTime      @default(now())

  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User         @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([changedAt])
  @@map("ticket_status_history")
}

// Individual notes added to a ticket by staff. isInternal=true means staff-only.
model RepairNote {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorId])
  @@map("repair_notes")
}

// A payment belongs to a ticket (deposit), an invoice, or both (paying a ticket's invoice).
model Payment {
  id            String        @id @default(cuid())
  ticketId      String?
  invoiceId     String?
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  // Reference ID for card/bank transactions.
  transactionId String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ticket  RepairTicket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  invoice Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts          Part[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

// Sellable product or repair part. Deactivated instead of deleted so history stays intact.
model Part {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  category          String?
  description       String?
  costPrice         Decimal  @default(0) @db.Decimal(10, 2)
  sellPrice         Decimal  @default(0) @db.Decimal(10, 2)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  supplierId        String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  ticketItems        TicketItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]
  invoiceItems       InvoiceItem[]

  @@index([name])
  @@index([category])
  @@index([supplierId])
  @@index([isActive])
  @@map("parts")
}

// Append-only stock ledger. Every quantity change on a Part writes one row.
model StockMovement {
  id          String              @id @default(cuid())
  partId      String
  change      Int
  reason      StockMovementReason
  // ID of the ticket item, purchase order or sale that caused the movement.
  referenceId String?
  note        String?
  createdById String
  createdAt   DateTime            @default(now())

  part      Part @relation(fields: [partId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([partId])
  @@index([createdAt])
  @@map("stock_movements")
}

// Parts and labor recorded against a repair ticket. partId is null for labor/custom lines.
model TicketItem {
  id          String   @id @default(cuid())
  ticketId    String
  partId      String?
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  unitCost    Decimal  @default(0) @db.Decimal(10, 2)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  part      Part?        @relation(fields: [partId], references: [id], onDelete: SetNull)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([partId])
  @@map("ticket_items")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  partId          String
  quantity        Int
  unitCost        Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([partId])
  @@map("purchase_order_items")
}

// ─── Sales ────────────────────────────────────────────────────────────────────

// Totals are stored at creation so historical invoices never change when prices do.
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  ticketId      String?
  status        InvoiceStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  // Percentage, e.g. 8.25
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?
  createdById   String
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ticket    RepairTicket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy  User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  partId      String?
  // True when copied from the ticket's parts & labor (stock was already taken when used).
  fromTicket  Boolean  @default(false)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  unitCost    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([partId])
  @@map("invoice_items")
}

// ─── Team ─────────────────────────────────────────────────────────────────────

// One row per shift worked. clockOut is null while the employee is clocked in;
// a partial unique index (see migration) allows at most one open entry per user.
model TimeEntry {
  id         String    @id @default(cuid())
  userId     String
  clockIn    DateTime
  clockOut   DateTime?
  notes      String?
  // Set when an admin corrects the entry.
  editedById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User  @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  editedBy User? @relation("TimeEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clockIn])
  @@map("time_entries")
}
