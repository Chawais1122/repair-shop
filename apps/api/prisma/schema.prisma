generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  // Technician is a User with this role — no separate Technician entity.
  TECHNICIAN
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  DESKTOP
  WATCH
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  REPAIRING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTickets RepairTicket[]        @relation("AssignedTo")
  createdTickets  RepairTicket[]        @relation("CreatedBy")
  statusChanges   TicketStatusHistory[]
  repairNotes     RepairNote[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]
  tickets RepairTicket[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Device {
  id           String     @id @default(cuid())
  customerId   String
  type         DeviceType
  brand        String
  model        String
  serialNumber String?
  imei         String?
  // Stored AES-256-GCM encrypted. Encryption key from environment variable.
  passcode     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets  RepairTicket[]

  @@index([customerId])
  @@index([serialNumber])
  @@index([imei])
  @@map("devices")
}

model RepairTicket {
  id                   String       @id @default(cuid())
  ticketNumber         String       @unique
  customerId           String
  deviceId             String
  assignedToId         String?
  createdById          String
  status               TicketStatus @default(RECEIVED)
  priority             Priority     @default(NORMAL)
  reportedProblem      String
  diagnosis            String?
  estimatedCost        Decimal?     @db.Decimal(10, 2)
  finalCost            Decimal?     @db.Decimal(10, 2)
  receivedAt           DateTime     @default(now())
  expectedCompletionAt DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  statusHistory TicketStatusHistory[]
  repairNotes   RepairNote[]
  payments      Payment[]

  @@index([status])
  @@index([customerId])
  @@index([assignedToId])
  @@index([ticketNumber])
  @@index([priority])
  @@index([status, createdAt])
  @@map("repair_tickets")
}

// Append-only audit log — never updated, only inserted.
model TicketStatusHistory {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  notes       String?
  changedAt   DateTime      @default(now())

  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User         @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([changedAt])
  @@map("ticket_status_history")
}

// Individual notes added to a ticket by staff. isInternal=true means staff-only.
model RepairNote {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorId])
  @@map("repair_notes")
}

model Payment {
  id            String        @id @default(cuid())
  ticketId      String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  // Reference ID for card/bank transactions.
  transactionId String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([status])
  @@map("payments")
}
