# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/repair_shop

# Server
PORT=3001
NODE_ENV=development

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:3000

# JWT — use long random strings in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Device passcode encryption — 64 hex chars (32 bytes) for AES-256
# Generate with: openssl rand -hex 32
DEVICE_ENCRYPTION_KEY=replace-with-64-hex-characters

# Where uploaded chat photos are stored (mount a volume here in Docker)
UPLOAD_DIR=./uploads
