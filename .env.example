# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (native):   postgresql://postgres:password@localhost:5432/repair_shop
# Docker Compose (api): postgresql://postgres:password@postgres:5432/repair_shop
DATABASE_URL="postgresql://postgres:password@localhost:5432/repair_shop"

# ── NestJS API ─────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Next.js ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
